---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
---

<BaseLayout title="Education | Renata Flavell">
  <section class="page-section top-space">
    <div class="container narrow">
      <SectionHeader
        eyebrow="Education"
        title="A thoughtful foundation for creative strategy and production."
        intro="My background combines formal learning with creative practice, giving me a grounded understanding of storytelling, communications, and how to execute ideas well."
      />
    </div>
  </section>

  <section class="page-section alt-bg">
    <div class="container education-list">
      <article class="education-card leopard-accent">
        <p class="eyebrow">Degree</p>
        <h3>BA / Relevant Creative Qualification</h3>
        <p class="meta">University or institution name</p>
        <p>Focus on communication, visual culture, storytelling, and creative thinking.</p>
      </article>

      <article class="education-card leopard-accent">
        <p class="eyebrow">Additional Study</p>
        <h3>Digital Marketing / Social Media / Production Training</h3>
        <p class="meta">Course or short programme</p>
        <p>Developed practical knowledge in digital strategy, audience engagement, and content delivery.</p>
      </article>

      <article class="education-card leopard-accent">
        <p class="eyebrow">Continuous Learning</p>
        <h3>Creative and strategic practice</h3>
        <p class="meta">Ongoing</p>
        <p>Constantly refining my approach through learning, creative experimentation, and industry observation.</p>
      </article>
    </div>
  </section>
</BaseLayout>
