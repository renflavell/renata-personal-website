---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
---

<BaseLayout title="Education | Renata Flavell">
  <section class="page-section top-space">
    <div class="container narrow">
      <SectionHeader
        eyebrow="Education"
        title="A foundation in business, digital marketing, and creative practice."
        intro="My education combines business management, digital marketing, media, communication, and performing arts, with international study experience in Portugal."
      />
    </div>
  </section>

  <section class="page-section alt-bg">
    <div class="container education-list">
      <article class="education-card leopard-accent">
        <p class="eyebrow">2024 — Present</p>
        <h3>BA (Hons) Business with Digital Marketing</h3>
        <p class="meta">Liverpool John Moores University</p>
        <p><strong>Relevant modules:</strong> Marketing, Media Production Management, Global Business Management, Managing People and Organisations, and Media Communications.</p>
      </article>

      <article class="education-card leopard-accent">
        <p class="eyebrow">January 2026 — June 2026</p>
        <h3>Erasmus Study Abroad — Management</h3>
        <p class="meta">Universidade Europeia, Portugal</p>
        <p><strong>Relevant modules:</strong> Creativity and Critical Thinking, and Business Law.</p>
      </article>

      <article class="education-card leopard-accent">
        <p class="eyebrow">2021 — 2023</p>
        <h3>Cambridge Extended Diploma in Performing Arts</h3>
        <p class="meta">Thomas Telford Sixth Form</p>
      </article>

      <article class="education-card leopard-accent">
        <p class="eyebrow">2015 — 2021</p>
        <h3>Secondary Education — GCSEs</h3>
        <p class="meta">The Dormston School</p>
      </article>
    </div>
  </section>
</BaseLayout>
