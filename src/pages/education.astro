---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
---

<BaseLayout title="Education | Renata Flavell">
  <section class="page-section top-space">
    <div class="container narrow">
      <SectionHeader
        eyebrow="Education"
        title="A thoughtful foundation for creative strategy and production."
        intro="My background combines formal learning with creative practice, giving me a grounded understanding of storytelling, communications, and how to execute ideas well."
      />
    </div>
  </section>

  <section class="page-section alt-bg">
    <div class="container education-list">
      <article class="education-card leopard-accent">
        <p class="eyebrow">Degree</p>
        <h3>BA / Hons in Marketing, Communications, or a related creative discipline</h3>
        <p class="meta">University or institution name</p>
        <p>Focused on communication, visual culture, storytelling, and creative thinking, with a strong foundation in how audiences connect with ideas.</p>
      </article>

      <article class="education-card leopard-accent">
        <p class="eyebrow">Additional Study</p>
        <h3>Digital marketing, social media, and production practice</h3>
        <p class="meta">Course, short programme, or professional training</p>
        <p>Developed practical knowledge in digital strategy, audience engagement, content planning, and effective creative delivery.</p>
      </article>

      <article class="education-card leopard-accent">
        <p class="eyebrow">Continuous Learning</p>
        <h3>Creative and strategic practice</h3>
        <p class="meta">Ongoing</p>
        <p>Constantly refining my approach through learning, creative experimentation, and observation of the evolving digital and cultural landscape.</p>
      </article>
    </div>
  </section>
</BaseLayout>
