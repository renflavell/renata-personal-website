---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
---

<BaseLayout title="Skills | Renata Flavell">
  <section class="page-section top-space">
    <div class="container narrow">
      <SectionHeader
        eyebrow="Skills"
        title="Strategy, creativity, and production working together."
        intro="I bring together the thinking, the language, and the practical execution needed to deliver polished creative work that connects with people."
      />
    </div>
  </section>

  <section class="page-section alt-bg">
    <div class="container skills-grid">
      <article class="skill-card leopard-accent">
        <p class="eyebrow">Marketing</p>
        <ul>
          <li>Brand storytelling</li>
          <li>Campaign planning</li>
          <li>Audience engagement</li>
          <li>Content strategy</li>
        </ul>
      </article>

      <article class="skill-card leopard-accent">
        <p class="eyebrow">Social Media</p>
        <ul>
          <li>Content planning</li>
          <li>Channel strategy</li>
          <li>Community building</li>
          <li>Creative scheduling</li>
        </ul>
      </article>

      <article class="skill-card leopard-accent">
        <p class="eyebrow">Production</p>
        <ul>
          <li>Creative coordination</li>
          <li>Project management</li>
          <li>Content delivery</li>
          <li>Cross-team collaboration</li>
        </ul>
      </article>

      <article class="skill-card leopard-accent">
        <p class="eyebrow">Creative</p>
        <ul>
          <li>Copy direction</li>
          <li>Visual storytelling</li>
          <li>Creative ideation</li>
          <li>Brand consistency</li>
        </ul>
      </article>
    </div>
  </section>
</BaseLayout>
