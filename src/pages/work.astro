---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
---

<BaseLayout title="Work | Renata Flavell">
  <section class="page-section top-space">
    <div class="container narrow">
      <SectionHeader
        eyebrow="Work"
        title="Guest experience, social content, hospitality, and administration."
        intro="My experience spans customer-facing travel work, hospitality, social media, sales, event support, and accounts administration."
      />
    </div>
  </section>

  <section class="page-section alt-bg">
    <div class="container">
      <div class="timeline">
        <div class="timeline-item">
          <span class="timeline-date">June 2026 — August 2026</span>
          <div class="timeline-content leopard-accent">
            <h3>Concierge</h3>
            <p class="meta">Party Hard Travel — Spain</p>
            <p>Returned for a second season after a successful first year in Greece.</p>
            <ul>
              <li>Created and managed social media content on TikTok and Instagram to promote events, destinations, and the Party Hard brand, reaching 4,791 followers and over 5,000 guests.</li>
              <li>Drove social sales by engaging with customers online and promoting event packages, generating numerous bookings.</li>
              <li>Led welcome meetings and wristband collections, advising guests on events, discounts, and their stay.</li>
              <li>Supported events throughout the season, ensuring smooth guest entry and resolving issues quickly.</li>
              <li>Built strong relationships through daily face-to-face interaction, delivering friendly and professional customer experiences.</li>
            </ul>
          </div>
        </div>

        <div class="timeline-item">
          <span class="timeline-date">April 2025 — August 2025</span>
          <div class="timeline-content leopard-accent">
            <h3>Bartender</h3>
            <p class="meta">The Drunken Monkey — Prague</p>
            <ul>
              <li>Opened and closed the bar for busy boat parties, preparing everything for each event.</li>
              <li>Managed stock between the bar and boats, transporting supplies so the right products were available for every party.</li>
              <li>Served drinks quickly and accurately to many guests per event in a fast-paced environment.</li>
              <li>Delivered friendly, engaging service to a diverse range of international guests.</li>
              <li>Worked closely with a team of three to keep boat parties running smoothly.</li>
            </ul>
          </div>
        </div>

        <div class="timeline-item">
          <span class="timeline-date">May 2024 — August 2024</span>
          <div class="timeline-content leopard-accent">
            <h3>Summer Representative</h3>
            <p class="meta">Party Hard Travel — Greece</p>
            <p>Welcomed and supported guests, promoted event packages, and helped events run smoothly. Built the customer service and sales skills later developed in a second season.</p>
          </div>
        </div>

        <div class="timeline-item">
          <span class="timeline-date">September 2023 — November 2023</span>
          <div class="timeline-content leopard-accent">
            <h3>Accounts Intern</h3>
            <p class="meta">Brennan Industries</p>
            <ul>
              <li>Processed and posted supplier invoices through the purchase ledger, keeping records accurate and up to date.</li>
              <li>Reconciled customer statements and collected payments, posting receipts to the accounting system.</li>
              <li>Reorganised the sales ledger filing system, making financial documents easier to access.</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
