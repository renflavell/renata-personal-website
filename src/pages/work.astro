---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
---

<BaseLayout title="Work | Renata Flavell">
  <section class="page-section top-space">
    <div class="container narrow">
      <SectionHeader
        eyebrow="Work"
        title="Creative work with strategy, craft, and personality."
        intro="I’ve built experience across marketing, content, social media, and production, helping teams translate ideas into polished, audience-aware experiences."
      />
    </div>
  </section>

  <section class="page-section alt-bg">
    <div class="container work-list">
      <article class="feature-card leopard-accent">
        <div>
          <p class="eyebrow">Marketing & Social</p>
          <h3>Brand storytelling and campaign execution</h3>
        </div>
        <p>
          Developed creative campaign concepts and social content that combined brand voice, audience needs, and performance goals.
        </p>
      </article>

      <article class="feature-card leopard-accent">
        <div>
          <p class="eyebrow">Production</p>
          <h3>Planning, coordination, and delivery</h3>
        </div>
        <p>
          Managed the moving parts behind content shoots, creative outputs, and cross-functional project timelines to keep work flowing smoothly and creatively.
        </p>
      </article>

      <article class="feature-card leopard-accent">
        <div>
          <p class="eyebrow">Content Strategy</p>
          <h3>Building clear, memorable experiences</h3>
        </div>
        <p>
          Created content plans and brand moments that felt useful, on-trend, and distinctly aligned with the audience and business goals.
        </p>
      </article>
    </div>
  </section>

  <section class="page-section">
    <div class="container">
      <div class="timeline">
        <div class="timeline-item">
          <span class="timeline-date">2022 — Present</span>
          <div class="timeline-content leopard-accent">
            <h3>Creative Marketing Professional</h3>
            <p>Leading work across content development, social storytelling, campaign coordination, and polished creative delivery.</p>
          </div>
        </div>

        <div class="timeline-item">
          <span class="timeline-date">2019 — 2022</span>
          <div class="timeline-content leopard-accent">
            <h3>Social Media & Content Specialist</h3>
            <p>Produced engaging brand content, built launch moments, and supported audience growth through strategic messaging and execution.</p>
          </div>
        </div>

        <div class="timeline-item">
          <span class="timeline-date">2017 — 2019</span>
          <div class="timeline-content leopard-accent">
            <h3>Production & Creative Support</h3>
            <p>Supported shoots, creative planning, and project coordination with a strong eye for detail and delivery quality.</p>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
